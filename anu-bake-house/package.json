{
  "name": "anu-bake-house",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev --host 127.0.0.1",
    "check": "node scripts/run-astro.mjs check",
    "build": "node scripts/run-astro.mjs build",
    "preview": "node scripts/run-astro.mjs preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/run-wrangler.mjs d1 migrations apply DB --local",
    "db:inspect:local": "node scripts/run-wrangler.mjs d1 execute DB --local --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@astrojs/react": "7.1.4",
    "astro": "7.4.7",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.15",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261108.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  },
  "type": "module",
  "overrides": {
    "@cloudflare/vite-plugin": {
      "ws": "8.22.1"
    }
  }
}
